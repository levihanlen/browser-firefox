## lh browser Brand
##
## The lowercase name is the brand's own spelling, so it stays lowercase at
## the start of a sentence too.
## Vendor stays Mozilla: it names Mozilla's services (accounts, add-ons,
## privacy notices), which this browser still uses.

-brand-shorter-name = lh browser
-brand-short-name = lh browser
-brand-shortcut-name = lh browser
-brand-full-name = lh browser
-brand-product-name = lh browser
-vendor-short-name = Mozilla
# The browser this one is built from, for the places that credit it.
-upstream-brand-name = Firefox
trademarkInfo = lh browser is built from the open source code of { -vendor-short-name } { -upstream-brand-name }.
