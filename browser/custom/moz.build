# Default pref files load in reverse-alphabetical order, so this file name has
# to sort before firefox.js and firefox-branding.js for its values to win.
JS_PREFERENCE_FILES += ["custom-prefs.js"]

EXTRA_COMPONENTS += ["custom.manifest"]

MOZ_SRC_FILES += ["CustomStartup.sys.mjs"]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")
