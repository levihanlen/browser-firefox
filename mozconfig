# Artifact build: download Mozilla's prebuilt engine and only build the front end.
ac_add_options --enable-artifact-builds
ac_add_options --with-branding=browser/branding/lh
# Bundle ID com.levihanlen.lhbrowser.
ac_add_options --with-distribution-id=com.levihanlen
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-artifact
